// ============================================================================
// SNAPSHOT ONLY — DO NOT EDIT OR DEPLOY FROM THIS REPO
//
// The source of truth for Firestore rules is the ADMIN project, which manages
// roles via JWT custom claims (see its ADR-013 / ADR-014). This file is a
// reference copy of the LIVE rules fetched on 2026-07-05 so the client repo
// is not misleading about what is actually deployed.
//
// Deliberately NOT wired into firebase.json: a `firebase deploy` from this
// repo must never overwrite the admin-side rules.
//
// CLIENT IMPACT: products/categories/temas reads now require authentication,
// which the public no-login catalog does not have. Until the public catalog
// mirror ships (docs/ROADMAP.md Phase 0), the client app's Firestore reads
// fail with permission-denied.
// ============================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helpers — use JWT custom claims set by the onUserRoleChanged CF (ADR-013).
    // No Firestore get() calls; zero per-request read cost.
    // -------------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.get('role', '') in ['admin', 'superuser'];
    }

    function hasPermission(permission) {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.get('permissions', {}).get(permission, false) == true
      );
    }

    // -------------------------------------------------------------------------
    // Collections
    // -------------------------------------------------------------------------

    // Products — authenticated read (kills costPrice public leak, ADR-014);
    // write requires products.createEdit permission
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('products.createEdit');
    }

    // Categories — authenticated read; admin write (pricing is admin-only)
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      match /subcategories/{subId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    // Temas — authenticated read; write requires products.createEdit
    match /temas/{temaId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('products.createEdit');
    }

    // Orders — legacy COD orders; authenticated only
    match /orders/{orderId} {
      allow read, write: if isAuthenticated();
    }

    // Sales — authenticated read; NO direct client writes (CF-only)
    match /sales/{saleId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Pending Cash — authenticated read; NO direct client writes (CF-only)
    match /pendingCash/{source} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Shipments — authenticated read; write requires shipments.receive permission
    // (completing a shipment increments stockWarehouse — must be gated)
    match /shipments/{shipmentId} {
      allow read: if isAuthenticated();
      allow create, update: if hasPermission('shipments.receive');
      allow delete: if isAdmin();
    }

    // Locations — authenticated read; admin write
    match /locations/{locationId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Movements — authenticated read; write requires movements.manage
    match /movements/{movementId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('movements.manage');
    }

    // Deposits — authenticated read; NO direct client writes. Deposits are only
    // created via processDeposit (which decrements pendingCash + stamps depositId
    // in one transaction); a direct client create would forge a deposit record
    // with no pendingCash effect. CFs use the admin SDK and bypass these rules.
    match /deposits/{depositId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Expenses — any authenticated user can create (lands in pending_approval);
    // approve/reject requires expenses.approve AND the expense must still be pending
    // (prevents retroactive amount changes on already-approved expenses);
    // hard delete is admin-only.
    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if hasPermission('expenses.approve') &&
        resource.data.status == 'pending_approval';
      allow delete: if isAdmin();
    }

    // Cierres — daily card-terminal reconciliation records; authenticated read,
    // NO direct client writes (submitCierre computes expectedTotal/discrepancy
    // server-side; resolveCierre is admin-only — both via admin SDK).
    match /cierres/{date} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Expense Categories — authenticated read; admin write
    match /expense_categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Users — authenticated read (needed by UI for user management);
    // admin write only (roles and permissions are admin-controlled)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Bank Accounts — sensitive financial data; admin only
    match /bankAccounts/{accountId} {
      allow read, write: if isAdmin();
    }

    // notifications collection intentionally omitted — unused (grep confirmed)
  }
}
